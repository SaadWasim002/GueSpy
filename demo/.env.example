# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored; application.properties imports it via spring.config.import.
# You can also supply these as real OS environment variables instead of a file.

# --- MySQL connection ---
# DB_URL is optional; it defaults to jdbc:mysql://localhost:3306/guespy
DB_URL=jdbc:mysql://localhost:3306/guespy
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- JWT signing secret ---
# Use a long, random string. HS256 needs at least 32 bytes.
# e.g. generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret
